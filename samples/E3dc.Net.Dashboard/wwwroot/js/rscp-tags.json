{
  "namespaces": {
    "EMS": {
      "name": "Energy Management System",
      "description": "Core energy flow monitoring and control. Provides real-time power values for solar, battery, grid, and home consumption.",
      "indexed": false
    },
    "BAT": {
      "name": "Battery",
      "description": "Battery module monitoring. Indexed per battery unit (usually index 0). Reports charge state, voltage, current, and cycle count.",
      "indexed": true,
      "defaultIndex": 0
    },
    "PVI": {
      "name": "Inverter (PV-Inverter)",
      "description": "Solar inverter monitoring. Indexed per inverter unit. Reports AC/DC power, voltage, current, and frequency per phase.",
      "indexed": true,
      "defaultIndex": 0
    },
    "PM": {
      "name": "Power Meter",
      "description": "Grid power meter. Indexed — common indices are 0 or 6 depending on E3DC model. Reports 3-phase power, voltage, and energy.",
      "indexed": true,
      "defaultIndex": 0
    },
    "DCDC": {
      "name": "DC-DC Converter",
      "description": "Battery DC-DC converter metrics. Reports the actual battery-side current, voltage, and power at the converter level.",
      "indexed": true,
      "defaultIndex": 0
    },
    "DB": {
      "name": "Database / History",
      "description": "Historical energy data stored on the E3DC. Query by day, week, month, or year. Returns aggregated production, consumption, grid, and battery data.",
      "indexed": false
    },
    "INFO": {
      "name": "Device Information",
      "description": "Static device metadata. Serial number, firmware version, network configuration. Typically queried once.",
      "indexed": false
    },
    "EP": {
      "name": "Emergency Power",
      "description": "Emergency power (Notstrom) status. Reports whether the system can switch to island mode, grid connection state, and island grid status.",
      "indexed": false
    },
    "WB": {
      "name": "Wallbox (EV Charger)",
      "description": "E3DC wallbox monitoring. Indexed per charger unit. Reports energy totals, charging status, mode, and per-phase power.",
      "indexed": true,
      "defaultIndex": 0
    },
    "HA": {
      "name": "Home Automation",
      "description": "Home automation datapoints and actuator control. Discovery-based — query the datapoint list first.",
      "indexed": false
    },
    "SYS": {
      "name": "System Control",
      "description": "System management commands. Reboot the E3DC or restart the application. Use with caution.",
      "indexed": false
    },
    "UM": {
      "name": "Update Manager",
      "description": "Firmware update status and version checking.",
      "indexed": false
    },
    "RSCP": {
      "name": "RSCP Protocol",
      "description": "Protocol-level tags for authentication and user level queries.",
      "indexed": false
    }
  },
  "tags": {
