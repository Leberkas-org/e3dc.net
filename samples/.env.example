# E3DC connection (required)
E3DC__Host=192.168.1.100
E3DC__User=your-portal-email
E3DC__Password=your-portal-password
E3DC__RscpKey=your-rscp-key

# Polling intervals (optional, defaults shown)
E3DC__FastPollingIntervalSeconds=2
E3DC__MediumPollingIntervalSeconds=10
E3DC__HistoryRetentionMinutes=60

# Device indices (optional, defaults shown)
E3DC__BatDeviceIndex=0
E3DC__PviDeviceIndex=0
E3DC__PmDeviceIndex=6
E3DC__DcdcDeviceIndex=0
E3DC__WbDeviceIndex=0
