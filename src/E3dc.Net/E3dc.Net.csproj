<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>E3dc</RootNamespace>
    <PackageId>E3dc.Net</PackageId>
    <Description>RSCP protocol client for E3DC S10 home battery systems. Akka.Streams-based reactive data flow with automatic reconnection, fluent request builder, and binary protocol implementation (framing, CRC32, Rijndael-256 encryption).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Condition="Exists('../../icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E3dc.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka.Streams" Version="1.5.*" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.*" />
    <PackageReference Include="System.IO.Hashing" Version="9.*" />
  </ItemGroup>

</Project>
